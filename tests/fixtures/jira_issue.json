    "comment": {
      "comments": [
        {
          "id": "20001",
          "author": {
            "displayName": "Casey Bodley",
            "accountId": "def456"
          },
          "body": "I can reproduce this. The issue is that the secondary zone's bucket instance info gets stale during resharding sync. The metadata sync needs to handle the ENOENT gracefully and re-fetch.",
          "created": "2024-10-20T14:30:00.000+0000",
          "updated": "2024-10-20T14:30:00.000+0000"
        },
        {
          "id": "20002",
          "author": {
            "displayName": "Pawan Dhiran",
            "accountId": "abc123"
          },
          "body": "Confirmed workaround: manually run `radosgw-admin bucket reshard --bucket=test-bucket --num-shards=32` on the secondary zone after the primary reshard completes.",
          "created": "2024-10-21T09:00:00.000+0000",
          "updated": "2024-10-21T09:00:00.000+0000"
        }
      ],
